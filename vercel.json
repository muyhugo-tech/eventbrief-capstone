{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 180,
      "includeFiles": "{fixtures/**,prompts/**,lib/**,public/**,evaluation/public-demo-v1/cases.json,node_modules/@sparticuz/chromium/bin/**,node_modules/@fontsource/montserrat/files/*.woff2,node_modules/@fontsource/playfair-display/files/*.woff2}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" },
    { "source": "/package", "destination": "/index.html" },
    { "source": "/tests", "destination": "/evaluation.html" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self' https://capstone.productfaculty.com" }
    ]
  }]
}
