# Optional real AI. Copy this file to .env.local in this folder.
# Keep the key blank in the public repository. Never put keys in browser code.
EVENTBRIEF_OPENAI_API_KEY=
EVENTBRIEF_MODEL=gpt-6.1-sol
# No paid request is allowed until both a private key and this flag are set.
EVENTBRIEF_LIVE_ENABLED=false
# Persistent allowance for a new local installation; failed attempts count too.
# Restarting does not refill it. This estimates token cost, not account billing.
EVENTBRIEF_MAX_LIVE_CALLS=8
EVENTBRIEF_APP_BUDGET_CENTS=100
# Optional EXTRA allowance after separately choosing another test budget.
# This preserves the original ledger. Leave commented out to keep it disabled.
# EVENTBRIEF_EXTENSION_BUDGET_CENTS=100
# EVENTBRIEF_EXTENSION_MAX_CALLS=8
# Supported extra limits: 1–500 cents and 1–30 calls. Neither resets on restart.
PORT=3135
